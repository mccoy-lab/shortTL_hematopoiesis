library(tidyverse)
library(data.table)
library(vcfR)
library(pbapply)
library(snow)
source("scm_functions.R")
# Read tree
tree <- read.tree(file = "data/ST1.nwk",) %>%
root(outgroup = "OUTGROUP", resolve.root = TRUE) %>%
drop.tip("OUTGROUP")
# Plot tree with scalebar (sub/site)
plot.phylo(x = ladderize(tree),
direction = "downwards",
color = "black",
cex = 0.5,
fsize = 0.8,
lwd = 2)
add.scale.bar(length = 0.01,
lwd = 2,
x = 0,
y = max(nodeHeights(tree)), cex = 0.5)
# Read substitution model
q <- read_cellphy_model("data/ST1.Q.txt")
# For visualization purposes, we will replace all "near-zero" values with zeroes
# and remove all vectors with zero rates
q.plot <- q
q.plot[which(q.plot == 0.001)] <- 0
plot.Qmatrix(x = q.plot,
show.zeros = FALSE,
text = FALSE,
signif = 2)
# Read VCF
vcf <- read.vcfR("data/ST1.scm_vars.vcf.gz", verbose = FALSE)
# Compile somatic SNV genotype priors
gt_states <- compile_gt_states.snp(vcf)
tibble(gt_states[["chr9_125226000"]])
scm <- runSCM_single(locus_str = "chr9_125226000",
tree = tree,
gt_state_list = gt_states,
Qmat = q,
reps = 1000,
cores = 6)
scm.summary <- summary(scm)
scm.summary
summarise_scm.snp(scm.summary,
plot = T,
legend = T)
summarise_scm.snp(scm,
plot = T,
legend = T)
scm
summarise_scm.snp(scm)
x <- summary(scm)
x <- x$ace %>% as.data.frame()
x
tr <- scm[[1]]
tr
x$constate(apply(x, 1, pull_consensus_state, threshold = 0.95))
x$constate <- apply(x, 1, pull_consensus_state, threshold = 0.95)
x
x$node <- rownames(x)
x
x[(tr$Nnode+1):nrow(x),]$node<-1:(length(tr$tip.label))
x
arrange(x, as.integer(node)) %>% pull(constate)
g_states <- arrange(x, as.integer(node)) %>% pull(constate)
x %>% arrange(as.integer(node)) %>% select(!c(node,constate))
o <- x %>% arrange(as.integer(node)) %>% select(!c(node,constate))
rownames(o) <- NULL
add_cols <- setdiff(c("AA", "CC", "GG", "TT", "AC",
"AG", "AT", "CG", "CT", "GT"),colnames(o))
o[,cols]
o[,add_cols]
o[,add_cols] <- 0
o
o <- o %>% c("AA", "CC", "GG", "TT", "AC",
"AG", "AT", "CG", "CT", "GT")
o
apply(o, 1, max)
o
