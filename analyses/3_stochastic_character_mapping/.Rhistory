# Required packages
library(phytools)
library(tidyverse)
library(data.table)
library(vcfR)
library(pbapply)
library(parallel)
# Visualization
library(ggtree)
source("scm_functions.R")
# Read tree
tree <- read.tree(file = "data/ST1.nwk",) %>%
root(outgroup = "OUTGROUP", resolve.root = TRUE) %>%
drop.tip("OUTGROUP")
# Plot tree with scalebar (sub/site)
plot.phylo(x = ladderize(tree),
direction = "downwards",
color = "black",
cex = 0.5,
fsize = 0.8,
lwd = 2)
add.scale.bar(length = 0.01,
lwd = 2,
x = 0,
y = max(nodeHeights(tree)), cex = 0.5)
